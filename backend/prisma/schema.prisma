generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Pengguna {
  id           Int           @id @default(autoincrement())
  name         String    
  subtitle     String?   
  username     String        @unique
  password     String
  role         Role          @default(KASIR)
  status       Boolean       @default(false)
  lastActive   DateTime? 
  transactions Transaction[] // RELASI DITAMBAHKAN DI SINI
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("pengguna")
}

enum Role {
  ADMIN
  KASIR
}

model Produk {
  id                 Int                 @id @default(autoincrement())
  code               String              @unique
  name               String
  sku                String?
  category           String
  buyPrice           Int
  nettPrice          Int
  stock              Int                 @default(0)
  unit               String              @default("pcs")
  image              String?             @db.LongText
  status             String              @default("active")
  updatedBy          String?
  transactionDetails TransactionDetail[] // RELASI DITAMBAHKAN DI SINI
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("produk")
}

model Transaction {
  id            Int                 @id @default(autoincrement())
  invoiceNumber String              @unique
  totalAmount   Int
  paymentMethod String
  userId        Int?
  user          Pengguna?           @relation(fields: [userId], references: [id])
  details       TransactionDetail[]
  createdAt     DateTime            @default(now())

  @@map("transaksi")
}

model TransactionDetail {
  id                 Int         @id @default(autoincrement())
  transactionId      Int
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId          Int
  product            Produk      @relation(fields: [productId], references: [id])
  quantity           Int
  priceAtTransaction Int

  @@map("transaksi_detail")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setting")
}